{
  "name": "dh-cauai-workspace",
  "frontend": "public/workspace-v206.js",
  "backend": "server.mjs",
  "transport": {
    "sameOriginCredentials": "same-origin",
    "csrfHeader": "x-csrf-token",
    "proxyPrefix": "/api/",
    "upstreamEnv": "REMOTE_ORIGIN"
  },
  "routes": [
    { "method": "GET", "path": "/api/v1/auth/me", "purpose": "session" },
    { "method": "GET", "path": "/api/v1/projects", "purpose": "project hydration" },
    { "method": "GET", "path": "/api/v1/media", "purpose": "private media hydration" },
    { "method": "GET", "path": "/api/v1/jobs", "purpose": "task refresh" },
    { "method": "GET", "path": "/api/v1/assistant/events", "purpose": "project-scoped assistant event stream" },
    { "method": "GET", "path": "/api/v1/assistant/threads", "purpose": "assistant thread hydration" },
    { "method": "POST", "path": "/api/v1/assistant/threads", "purpose": "assistant thread creation" },
    { "method": "GET", "path": "/api/v1/assistant/threads/:threadId/messages", "purpose": "assistant message hydration" },
    { "method": "POST", "path": "/api/v1/assistant/threads/:threadId/messages", "purpose": "assistant advice and proposal creation" },
    { "method": "POST", "path": "/api/v1/assistant/actions/:actionId/confirm", "purpose": "explicit assistant action confirmation" },
    { "method": "POST", "path": "/api/v1/assistant/proposals/:proposalId/conflict-choice", "purpose": "assistant media conflict resolution" },
    { "method": "POST", "path": "/api/v1/projects/:id/first-frame/drafts", "purpose": "first-frame analysis" },
    { "method": "POST", "path": "/api/v1/projects/:id/first-frame/drafts/:draftId/confirm", "purpose": "first-frame submission" },
    { "method": "GET", "path": "/api/v1/jobs/:jobId", "purpose": "targeted persistent job synchronization" },
    { "method": "POST", "path": "/api/v1/workspace/opened", "purpose": "workspace readback" }
  ]
}
